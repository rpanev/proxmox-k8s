# Copy to secrets.env — edit before first deploy.
# Order: toggles → infra (Proxmox, SSH, network) → cluster → per-service config.
# Toggle docs (one page each): docs/toggles/
# VM sizing/placement: terrafrom/linux|talos-linux/terraform.tfvars
# K3s token: secrets/<ENV_ID>/k3s_token (auto-generated)

# ===== 1. Platform toggles =====
# See docs/toggles/README.md for configuration details per flag.
# Proxmox VM disks: Ceph (true) or NFS via PROXMOX_DATASTORE_ID (false)
CEPH_STORAGE=false
PROXMOX_SHARED_STORAGE=true
PROXMOX_DATASTORE_ID=SSD-storage
TAILSCALE_ENABLED=true
LONGHORN_ENABLED=true
SNAPSHOT_CONTROLLER_ENABLED=true
DATADOG_ENABLED=true
ARGOCD_ENABLED=true
VELERO_ENABLED=false
KASTEN_ENABLED=false
GATEWAY_ENABLED=true
EXTERNAL_DNS_ENABLED=true
SEALED_SECRETS_ENABLED=true
RELOADER_ENABLED=true
METRICS_SERVER_ENABLED=true
ARGOCD_BOOTSTRAP_ENABLED=true
PROMETHEUS_ENABLED=true
ALERTMANAGER_ENABLED=false
LOKI_ENABLED=false
TAILSCALE_EXPORTER_ENABLED=false
TRIVY_OPERATOR_ENABLED=false

# ===== 2. Proxmox =====
PROXMOX_ENDPOINT="https://192.168.99.5:8006/"
PROXMOX_API_TOKEN="root@pam!terraform=CHANGE_ME"
PROXMOX_INSECURE=true
PROXMOX_SSH_USERNAME=root
TEMPLATE_NAME=almalinux10-cloud
TEMPLATE_VM_ID=9001
TEMPLATE_NODE=node4
# Talos image for CP/workers when TALOS_ENABLED=true (LB always uses TEMPLATE_* Debian)
TALOS_TEMPLATE_NAME=talos-linux-1-13-4
TALOS_TEMPLATE_VM_ID=9006
TALOS_TEMPLATE_NODE=node4
ENV_ID=homelab
# Pool name, VM names ({ENV_ID}-lb, …), inventory path, PBS backup notes prefix
VM_TAGS="k8s terraform homelab"

# ===== 3. SSH / cloud-init =====
SSH_USER=root
SSH_PASSWORD=CHANGE_ME
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... user@host"
# ANSIBLE_FORKS=10

# ===== 4. Network =====
NETWORK_BRIDGE=vmbr0
NETWORK_GATEWAY=192.168.99.1
NETWORK_CIDR=24
IP_BASE=192.168.99
VLAN_TAG=0
DNS_DOMAIN=panev.cloud
DNS_SERVERS="1.1.1.1"

# ===== 5. Cluster =====
LEADER_COUNT=3
WORKER_COUNT=3
K3S_VERSION=v1.36.1+k3s1

# ===== 6. Tailscale (TAILSCALE_ENABLED) =====
TAILSCALE_TAILNET=tail9822c.ts.net
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
TAILSCALE_APPLY_ACL=true
TAILSCALE_SUBNET_ROUTER_ENABLED=true
# TAILSCALE_EXTRA_ROUTES=10.42.0.0/16,10.43.0.0/16
TAILSCALE_API_SERVER_PROXY=false
TAILSCALE_LOGIN_SERVER=

# ===== 7. Gateway + DNS (GATEWAY_ENABLED) =====
# MetalLB IP — must be free on your LAN (e.g. .211; .210 = K8s API LB)
GATEWAY_LB_IP=192.168.99.211
GATEWAY_DOMAIN=homelab.panev.cloud
ACME_EMAIL=you@panev.cloud
LETSENCRYPT_STAGING=false
# Cloudflare token: Zone → DNS → Edit for GATEWAY_DOMAIN
CLOUDFLARE_API_TOKEN=CHANGE_ME
# DNS only (grey cloud) for private GATEWAY_LB_IP; true = orange cloud (needs public IP)
CLOUDFLARE_DNS_PROXIED=false
# Apex zone for external-dns — NOT the gateway subdomain. Auto-derived when empty.
EXTERNAL_DNS_DOMAIN_FILTER=
# First Let's Encrypt issue (DNS-01) — default 10m
GATEWAY_TLS_WAIT_TIMEOUT=10m

# ===== 8. Platform hostnames & sizing =====
ARGOCD_HOSTNAME=argocd
GRAFANA_HOSTNAME=grafana
PROMETHEUS_HOSTNAME=prometheus
LONGHORN_HOSTNAME=longhorn
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_RETENTION=15d
WORKER_DATA_DISK_GB=30
# Talos: Longhorn needs iscsi-tools + util-linux-tools (Image Factory schematic; auto when LONGHORN_ENABLED)
# bootstrap-talos.sh upgrades all nodes with the factory image before bootstrap when extensions are missing.
# TALOS_INSTALLER_SCHEMATIC=e187c9b90f773cd8c84e5a3265c5554ee787b2fe67b508d9f955e90e7ae8c96c
# K3s + Talos: same mount path on workers (Ansible fstab or Talos UserVolumeConfig)
LONGHORN_MOUNT_PATH=/var/mnt/longhorn-data
LONGHORN_DATA_DISK_FSTYPE=xfs
PROMETHEUS_WAIT_TIMEOUT=15m
LONGHORN_WAIT_TIMEOUT=15m
# LONGHORN_MANAGER_ROLLOUT_TIMEOUT=900s   # kubectl rollout status for longhorn-manager DS
# LONGHORN_ROLLOUT_ATTEMPTS=2
# ETCD_COOLDOWN_SECONDS=30                 # K3s default; Talos default 20
# ETCD_COOLDOWN_STABLE_CHECKS=4            # K3s default; Talos default 2
# HELM_WAIT_ROLLOUT_ATTEMPTS=3
# KUBECTL_API_RETRY_ATTEMPTS=3

# ===== 9. Loki (LOKI_ENABLED) =====
# Requires PROMETHEUS_ENABLED=true. Promtail ships journald + /var/log from every VM.
LOKI_RETENTION=168h
LOKI_STORAGE_SIZE=20Gi
LOKI_GATEWAY_NODE_PORT=31080
LOKI_WAIT_TIMEOUT=10m

# ===== 10. Velero (VELERO_ENABLED) =====
VELERO_S3_URL=http://192.168.99.50:29990
VELERO_S3_BUCKET=k8s-homelab
VELERO_S3_ACCESS_KEY=CHANGE_ME
VELERO_S3_SECRET_KEY=CHANGE_ME
VELERO_S3_INSECURE=true
VELERO_SCHEDULE_ENABLED=true
VELERO_SCHEDULE_CRON=0 2 * * *
VELERO_BACKUP_TTL=720h

# ===== 10b. Kasten (KASTEN_ENABLED) — NFS FileStore Location Profile =====
# App backup (≠ Longhorn PVC storage, ≠ Proxmox SSD-storage). See docs/backup.md
# KASTEN_ENABLED=true
# VELERO_ENABLED=false
KASTEN_NAMESPACE=kasten-io
KASTEN_HOSTNAME=kasten
KASTEN_STORAGE_CLASS=longhorn-1r
KASTEN_NFS_SERVER=192.168.99.50
KASTEN_NFS_PATH=/volume1/k8s-dr
KASTEN_NFS_SIZE=1Ti
KASTEN_LOCATION_PROFILE=nfs-k8s-dr
KASTEN_POLICY_ENABLED=true
KASTEN_POLICY_NAME=homelab-all-apps
KASTEN_POLICY_FREQUENCY=@daily
KASTEN_POLICY_HOUR=2
KASTEN_POLICY_RETENTION_DAILY=7
KASTEN_POLICY_RETENTION_WEEKLY=4
KASTEN_POLICY_RETENTION_MONTHLY=3
KASTEN_POLICY_EXCLUDE=kube-system,kube-public,kube-node-lease,kasten-io
KASTEN_DR_POLICY_ENABLED=true
KASTEN_DR_POLICY_FREQUENCY=@daily
KASTEN_DR_POLICY_HOUR=3
KASTEN_DR_POLICY_RETENTION_DAILY=7

# ===== 11. Datadog (DATADOG_ENABLED) =====
DATADOG_API_KEY=CHANGE_ME
DATADOG_SITE=datadoghq.eu
DATADOG_CLUSTER_NAME=k8s-homelab
DATADOG_WAIT_TIMEOUT=15m

# ===== 12. GitOps bootstrap (ARGOCD_BOOTSTRAP_ENABLED) =====
# GITOPS_REPO_URL=https://github.com/you/homelab.git
GITOPS_REPO_BRANCH=main
GITOPS_APPS_PATH=gitops/apps
